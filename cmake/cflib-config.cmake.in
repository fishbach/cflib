@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

@CFLIB_INSTALL_CONFIG_DEPS@

include("${CMAKE_CURRENT_LIST_DIR}/cflib-targets.cmake")
check_required_components(cflib)

block()
    foreach(target @CFLIB_LIB_TARGETS@)
        get_target_property(inc_dir ${target} INTERFACE_INCLUDE_DIRECTORIES)

        get_target_property(daos ${target} DAO_HEADERS_REL)
        if(NOT daos STREQUAL "daos-NOTFOUND")
            set(daos_abs)
            foreach(f IN LISTS daos)
                cmake_path(APPEND inc_dir "${f}" OUTPUT_VARIABLE f)
                list(APPEND daos_abs "${f}")
            endforeach()
            set_target_properties(${target} PROPERTIES DAO_HEADERS "${daos_abs}")
        endif()

        get_target_property(rmis ${target} RMI_SERVICE_HEADERS_REL)
        if(NOT rmis STREQUAL "rmis-NOTFOUND")
            set(rmis_abs)
            foreach(f IN LISTS rmis)
                cmake_path(APPEND inc_dir "${f}" OUTPUT_VARIABLE f)
                list(APPEND rmis_abs "${f}")
            endforeach()
            set_target_properties(${target} PROPERTIES RMI_SERVICE_HEADERS "${rmis_abs}")
        endif()
    endforeach()
endblock()

set(CFLIB_DATA_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/cflib")

macro(cf_project_config)
    if("${ARGV0}" STREQUAL "ENABLE_TESTING")
        find_package(doctest @CFLIB_DOCTEST_SYSTEM_VERSION@ REQUIRED)
        include(doctest)
        set(CFLIB_BUILD_TESTS ON)
    endif()
    include("${cflib_DIR}/ProjectConfig.cmake")
    @CFLIB_INSTALL_GENERATORS_FROM_PATH@
    if("${ARGV0}" STREQUAL "ENABLE_TESTING")
        add_library(cflib_testmain OBJECT "${CFLIB_DATA_DIR}/util/testmain/main.cpp")
        target_link_libraries(cflib_testmain PUBLIC cflib_util doctest::doctest)
        if(ENABLE_PCH)
            target_precompile_headers(cflib_testmain PRIVATE "${CFLIB_DATA_DIR}/util/testmain/pch.h")
        endif()
    endif()
endmacro()
