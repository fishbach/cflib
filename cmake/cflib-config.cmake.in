@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

@CFLIB_INSTALL_CONFIG_DEPS@

include("${CMAKE_CURRENT_LIST_DIR}/cflib-targets.cmake")
check_required_components(cflib)

set(CFLIB_DATA_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/cflib")

macro(cf_project_config)
    include("${cflib_DIR}/ProjectConfig.cmake")
    if("${ARGV0}" STREQUAL "ENABLE_TESTING")
        find_package(doctest 2.4.12 REQUIRED)
        include(doctest)
        add_library(cflib_testmain OBJECT "${CFLIB_DATA_DIR}/util/testmain/main.cpp")
        target_link_libraries(cflib_testmain PUBLIC cflib_util doctest::doctest)
    endif()
endmacro()
